{
  "name": "editorial-portfolio-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.js",
    "build": "vite build && node scripts/write-nojekyll.mjs",
    "privacy:check": "node scripts/privacy-check.mjs .",
    "privacy:history": "node scripts/privacy-history-check.mjs",
    "verify": "npm test && npm run build && npm run privacy:check",
    "release:check": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "gsap": "^3.12.5",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "fix-webm-duration": "^1.0.6",
    "playwright-core": "^1.62.1",
    "vite": "^8.3.0"
  }
}
